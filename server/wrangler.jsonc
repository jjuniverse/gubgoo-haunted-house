{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gubgoo-haunted-house-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "APP_URL": "https://YOUR_GITHUB_USERNAME.github.io/gubgoo-haunted-house/",
    "SLACK_TEAM_ID": "REPLACE_WITH_YOUR_WORKSPACE_ID",
    "SLACK_CLIENT_ID": "REPLACE_WITH_YOUR_APP_CLIENT_ID"
  },
  "d1_databases": [{"binding": "DB", "database_name": "gubgoo-haunted-house", "database_id": "REPLACE_WITH_D1_DATABASE_ID"}]
}
